{
  "name": "@local/dsh-bilibili-audio",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "B站音频播放器：左侧栏入口 + 解析 BV 号/链接、代理音频流、本地收藏",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
